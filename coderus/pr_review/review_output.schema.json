{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "change_summary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "file_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "line_side": {
            "type": "string",
            "enum": ["LEFT", "RIGHT"]
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "priority",
          "title",
          "file_path",
          "line_side",
          "line_start",
          "line_end",
          "problem",
          "impact",
          "suggestion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["change_summary", "findings"],
  "additionalProperties": false
}
